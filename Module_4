clear; clc; close all;

%% ---------------- PARAMETERS ----------------
N = 100;
k = 6;          % degree = 6 (3 neighbors each side)
p = 0.1;        % base rewiring

T = 40;
dt = 0.01;
steps = T/dt;

omega = randn(N,1);   % Gaussian N(0,1)

%% ---------------- NETWORK ----------------
A = watts_strogatz(N,k,p);

%% ===================================================
%% (1) SYNCHRONIZATION vs K
%% ===================================================

K_values = linspace(0,3,25);
rK = zeros(size(K_values));

for i = 1:length(K_values)
    rK(i) = simulate_r(omega, A, K_values(i), dt, steps);
end

% --- Critical coupling ---
dr = gradient(rK, K_values);
[~, idx] = max(dr);
Kc = K_values(idx);

figure;
plot(K_values, rK,'o-','LineWidth',2); hold on;
xline(Kc,'r--','LineWidth',2);
xlabel('K'); ylabel('r');
title(['Synchronization vs K (K_c ≈ ', num2str(Kc,2), ')']);
grid on;

%% ===================================================
%% (2) REGIME SELECTION (DATA-DRIVEN)
%% ===================================================

idx_low  = find(rK < 0.2, 1, 'last');
idx_high = find(rK > 0.9, 1, 'first');

if isempty(idx_low), idx_low = 1; end
if isempty(idx_high), idx_high = length(K_values); end

K_test = [K_values(idx_low), Kc, K_values(idx_high)];

%% ===================================================
%% (3) REGIME ANALYSIS + PHASE LOCKING
%% ===================================================

for K = K_test
    
    [r_t, theta, omega_eff] = simulate_full(omega, A, K, dt, steps);
    
    % --- r(t)
    figure;
    plot((0:steps-1)*dt, r_t,'LineWidth',2);
    xlabel('Time'); ylabel('r');
    title(['r(t), K = ', num2str(K)]);
    
    % --- Phase snapshot
    figure;
    plot(theta,'o');
    xlabel('Node'); ylabel('\theta');
    title(['Phase snapshot, K = ', num2str(K)]);
    
    % --- Effective frequencies (phase locking)
    figure;
    plot(omega_eff,'o');
    xlabel('Node'); ylabel('\omega_{eff}');
    title(['Effective frequencies, K = ', num2str(K)]);
    
    % --- Frequency spread (locking measure)
    freq_spread = std(omega_eff);
    disp(['K = ', num2str(K), ' | Frequency spread = ', num2str(freq_spread)]);
    
end

%% ===================================================
%% (4) SYNCHRONIZATION vs p (AT Kc)
%% ===================================================

K_fixed = Kc;
p_values = linspace(0,1,12);
rP = zeros(size(p_values));

for i = 1:length(p_values)
    
    A = watts_strogatz(N,k,p_values(i));
    rP(i) = simulate_r(omega, A, K_fixed, dt, steps);
    
end

figure;
plot(p_values, rP,'o-','LineWidth',2);
xlabel('p'); ylabel('r');
title(['Synchronization vs p (K ≈ ', num2str(Kc,2), ')']);
grid on;

%% ===================================================
%% (5) EFFECT OF p AT DIFFERENT K REGIMES
%% ===================================================

p_values = linspace(0,1,12);
labels = {'Low K','Critical K','High K'};

figure;

for c = 1:length(K_test)
    
    K = K_test(c);
    rP = zeros(size(p_values));
    
    for i = 1:length(p_values)
        
        A = watts_strogatz(N,k,p_values(i));
        rP(i) = simulate_r(omega, A, K, dt, steps);
        
    end
    
    plot(p_values, rP,'o-','LineWidth',2); hold on;
    
end

xlabel('p'); ylabel('r');
title('Effect of p at different K regimes');
legend(labels,'Location','best');
grid on;

%% ===================================================
%% ---------------- FUNCTIONS ----------------
%% ===================================================

function r_ss = simulate_r(omega, A, K, dt, steps)

N = length(omega);
theta = 2*pi*rand(N,1);
r_t = zeros(steps,1);

for t = 1:steps
    
    dtheta = zeros(N,1);
    
    for i = 1:N
        dtheta(i) = omega(i) + K * sum(A(i,:) .* sin(theta' - theta(i)));
    end
    
    theta = theta + dt*dtheta;
    r_t(t) = abs(mean(exp(1i*theta)));
end

r_ss = mean(r_t(end-200:end));

end


function [r_t, theta, omega_eff] = simulate_full(omega, A, K, dt, steps)

N = length(omega);
theta = 2*pi*rand(N,1);
r_t = zeros(steps,1);

theta_history = zeros(N,steps);

for t = 1:steps
    
    dtheta = zeros(N,1);
    
    for i = 1:N
        dtheta(i) = omega(i) + K * sum(A(i,:) .* sin(theta' - theta(i)));
    end
    
    theta = theta + dt*dtheta;
    theta_history(:,t) = theta;
    
    r_t(t) = abs(mean(exp(1i*theta)));
end

% Effective frequency
omega_eff = mean(diff(theta_history,1,2)/dt,2);

end


function A = watts_strogatz(N,k,p)

A = zeros(N);

% Ring lattice (3 neighbors each side)
for i = 1:N
    for j = 1:k/2
        A(i, mod(i+j-1,N)+1) = 1;
        A(i, mod(i-j-1,N)+1) = 1;
    end
end

% Rewiring
for i = 1:N
    for j = 1:N
        if A(i,j)==1 && rand < p
            A(i,j)=0;
            new = randi(N);
            while new==i
                new = randi(N);
            end
            A(i,new)=1;
        end
    end
end

end
