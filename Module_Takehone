%% =========================================================
%% 8. CHIMERA STATE (NONLOCAL COUPLING)
%% =========================================================
N = 100; T = 400;
r = 2.9; eps = 0.45;
R = 35;

x = linspace(0.1,2,N) + 0.01*rand(1,N);
data = zeros(T,N);

for t = 1:T
    fx = f(x,r);
    x_new = zeros(1,N);
    
    for i = 1:N
        sum_neighbors = 0;
        
        for j = -R:R
            idx = mod(i+j-1,N)+1;
            sum_neighbors = sum_neighbors + fx(idx);
        end
        
        x_new(i) = (1-eps)*fx(i) + (eps/(2*R))*sum_neighbors;
    end
    
    x = x_new;
    data(t,:) = x;
end

figure;
imagesc(data)
colorbar
title('Chimera State (Spatiotemporal)')






%% =========================================================
%% 11. LYAPUNOV EXPONENT (LATTICE APPROX)
%% =========================================================
N = 50; T = 300;
r = 2.7; eps = 0.2;

x = rand(1,N);
xp = x + 1e-8*rand(1,N);

sum_log = 0;

for t = 1:T
    fx = f(x,r);
    fxp = f(xp,r);
    
    x_new = zeros(1,N);
    xp_new = zeros(1,N);
    
    for i = 1:N
        left = mod(i-2,N)+1;
        right = mod(i,N)+1;
        
        x_new(i) = (1-eps)*fx(i) + (eps/2)*(fx(left)+fx(right));
        xp_new(i) = (1-eps)*fxp(i) + (eps/2)*(fxp(left)+fxp(right));
    end
    
    delta = norm(xp_new - x_new);
    sum_log = sum_log + log(delta);
    
    xp_new = x_new + (xp_new - x_new)/delta * 1e-8;
    
    x = x_new;
    xp = xp_new;
end

lambda = sum_log / T
disp(['Lyapunov exponent (lattice) = ', num2str(lambda)]);
