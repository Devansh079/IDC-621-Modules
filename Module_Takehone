%% =========================================================
%  NONLINEAR MAP: x_{n+1} = x^2 * exp(r - x)
%  FULL ANALYSIS: Single + Coupled + Chimera + Lyapunov
% =========================================================

clear; clc; close all;

f = @(x,r) x.^2 .* exp(r - x);

%% =========================================================
%% 1. TIME SERIES (SINGLE MAP)
%% =========================================================
r = 2; N = 300;
x = zeros(1,N); x(1) = 0.5;

for i = 1:N-1
    x(i+1) = f(x(i), r);
end

figure;
plot(x,'LineWidth',1.5)
title('Time Series (Single Map)')
xlabel('n'); ylabel('x_n'); grid on;


%% =========================================================
%% 2. LYAPUNOV INSTABILITY (TRAJECTORY DIVERGENCE)
%% =========================================================
x1 = zeros(1,N); x2 = zeros(1,N);
x1(1)=0.5; x2(1)=0.500001;

for i = 1:N-1
    x1(i+1)=f(x1(i),r);
    x2(i+1)=f(x2(i),r);
end

figure;
semilogy(abs(x1-x2),'LineWidth',1.5)
title('Lyapunov Instability')
xlabel('n'); ylabel('|Δx|'); grid on;


%% =========================================================
%% 3. FAST BIFURCATION DIAGRAM (VECTORIZED)
%% =========================================================
r_vals = linspace(1,3,1200);
Nr = length(r_vals);

iterations = 800;
last = 200;

x = rand(1,Nr);

for i = 1:(iterations-last)
    x = f(x, r_vals);
end

X = zeros(last, Nr);

for i = 1:last
    x = f(x, r_vals);
    X(i,:) = x;
end

figure;
plot(r_vals, X, '.', 'MarkerSize', 1);
title('Bifurcation Diagram')
xlabel('r'); ylabel('x'); ylim([0 6]); grid on;


%% =========================================================
%% 4. LYAPUNOV EXPONENT (SINGLE MAP)
%% =========================================================
r_vals = linspace(1,3,500);
lyap = zeros(size(r_vals));

for j = 1:length(r_vals)
    r = r_vals(j);
    x = rand;
    sum_log = 0;
    
    for i = 1:600
        x = f(x,r);
        df = exp(r - x)*(2*x - x^2);
        sum_log = sum_log + log(abs(df));
    end
    
    lyap(j) = sum_log/600;
end

figure;
plot(r_vals, lyap,'LineWidth',1.5)
yline(0,'r--')
title('Lyapunov Exponent')
xlabel('r'); ylabel('\lambda'); grid on;


%% =========================================================
%% 5. COUPLED 2-MAP SYSTEM (SYNCHRONIZATION)
%% =========================================================
r = 2; eps = 0.7; N = 300;

x1 = zeros(1,N); x2 = zeros(1,N);
x1(1)=0.2; x2(1)=0.8;

for i = 1:N-1
    fx1 = f(x1(i),r);
    fx2 = f(x2(i),r);
    
    x1(i+1) = (1-eps)*fx1 + eps*fx2;
    x2(i+1) = (1-eps)*fx2 + eps*fx1;
end

figure;
plot(x1,'b'); hold on;
plot(x2,'r');
legend('x1','x2')
title('Coupled Map Synchronization')


%% =========================================================
%% 6. COUPLED MAP LATTICE (SPATIOTEMPORAL)
%% =========================================================
N = 80; T = 300;
r = 2.5; eps = 0.25;

x = rand(1,N);
data = zeros(T,N);

for t = 1:T
    fx = f(x,r);
    x_new = zeros(1,N);
    
    for i = 1:N
        left = fx(mod(i-2,N)+1);
        right = fx(mod(i,N)+1);
        
        x_new(i) = (1-eps)*fx(i) + (eps/2)*(left+right);
    end
    
    x = x_new;
    data(t,:) = x;
end

figure;
imagesc(data)
colorbar
title('Spatiotemporal Dynamics')
xlabel('Space'); ylabel('Time');
